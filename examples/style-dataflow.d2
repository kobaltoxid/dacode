direction: right

vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
    # Neutral greys for anything left unclassed, instead of the theme's default blue.
    theme-overrides: {
      B1: "#5F6B76"
      B2: "#5F6B76"
      B3: "#E5E8EB"
      B4: "#F2F4F5"
      B5: "#F7F8F9"
      B6: "#FFFFFF"
    }
    dark-theme-overrides: {
      B1: "#AAB2BA"
      B2: "#AAB2BA"
      B3: "#3A4148"
      B4: "#2C3238"
      B5: "#24292E"
      B6: "#1E2226"
    }
  }
  colors: {
    owned: "#FFE58A"
    owned-line: "#A07C00"
    owned-text: "#2B2300"
    store: "#CDEBC0"
    store-line: "#2F6B2F"
    store-text: "#132B10"
    neutral: "#8C949E"
    desired: "#228B22"
    undesired: "#D32F2F"
  }
}

classes: {
  # A component the system owns: the main subject of the diagram.
  owned: {
    style: {
      fill: ${colors.owned}
      stroke: ${colors.owned-line}
      font-color: ${colors.owned-text}
      stroke-width: 2
      border-radius: 6
      bold: true
    }
  }
  # Stored data: databases, queues, files, caches.
  store: {
    shape: cylinder
    style: {
      fill: ${colors.store}
      stroke: ${colors.store-line}
      font-color: ${colors.store-text}
      stroke-width: 2
      bold: true
    }
  }
  # Something outside the system: a client, service, or third party.
  external: {
    style: {
      fill: transparent
      stroke: ${colors.neutral}
      stroke-width: 2
      stroke-dash: 4
      border-radius: 6
      bold: false
    }
  }
  # A person outside the system. A dashed outline makes the icon look broken, so keep it solid.
  person: {
    shape: person
    style: {
      fill: transparent
      stroke: ${colors.neutral}
      stroke-width: 2
    }
  }
  # An ownership or deployment boundary.
  boundary: {
    style: {
      fill: transparent
      stroke: ${colors.neutral}
      stroke-width: 1
      font-size: 16
      border-radius: 4
    }
  }
  # The desired path: what should happen.
  flow: {
    style: {
      stroke: ${colors.desired}
      stroke-width: 2
    }
  }
  # A reply, read-back, recovery, or optional side effect.
  reply: {
    style: {
      stroke: ${colors.neutral}
      stroke-width: 2
      stroke-dash: 4
    }
  }
  # A structural relationship with no direction, drawn with --.
  link: {
    style: {
      stroke: ${colors.neutral}
      stroke-width: 1
    }
  }
  # An undesired path: failure, rejection, or error.
  fail: {
    style: {
      stroke: ${colors.undesired}
      font-color: ${colors.undesired}
      stroke-width: 2
      stroke-dash: 4
      bold: true
    }
  }
  # A state or outcome nobody wants: failure, rejection, dead letter.
  failed: {
    style: {
      fill: transparent
      stroke: ${colors.undesired}
      font-color: ${colors.undesired}
      stroke-width: 2
      border-radius: 6
      bold: true
    }
  }
  # Start and end markers for state machines.
  start: {
    shape: circle
    label: ""
    width: 20
    style: {
      fill: ${colors.desired}
      stroke: ${colors.desired}
    }
  }
  end: {
    shape: circle
    label: ""
    width: 24
    style: {
      fill: transparent
      stroke: ${colors.desired}
      stroke-width: 6
    }
  }
}

vars: {
  d2-legend: {
    o: Processing step {class: owned}
    s: Stored data {class: store}
    o -> s: main path {class: flow}
    o -> s: copy {class: reply}
    o -> s: rejected {class: fail}
  }
}

sensors: Sensors {class: external}
uploads: Uploads {class: external}
ingest: Ingest {class: owned}
raw: Raw store {class: store}
clean: Clean {class: owned}
aggregate: Aggregate {class: owned}
warehouse: Warehouse {class: store}
sensors -> ingest: readings {class: flow}
uploads -> ingest: CSV files {class: flow}
ingest -> raw: copy {class: reply}
ingest -> clean: rows {class: flow}
clean -> aggregate: valid rows {class: flow}
clean -> raw: rejects {class: fail}
aggregate -> warehouse: daily totals {class: flow}
